{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/*.css",
          "/*.js",
          "/manifest.webmanifest",
          "/icons/ricettario.svg",
          "/icons/ricettario-180.png",
          "/icons/ricettario-192.png",
          "/icons/ricettario-512.png"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**"
  ]
}
